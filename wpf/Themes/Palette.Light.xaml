<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ══ 浅色主题（默认强调色：Fluent 蓝） ══ -->
  <Color x:Key="BrandColor">#2D7CF6</Color>
  <SolidColorBrush x:Key="BrandBrush" Color="#2D7CF6"/>
  <SolidColorBrush x:Key="BrandHoverBrush" Color="#1F6BE8"/>
  <SolidColorBrush x:Key="BrandPressedBrush" Color="#1857C4"/>
  <SolidColorBrush x:Key="BrandLightBrush" Color="#1F2D7CF6"/>
  <SolidColorBrush x:Key="BrandDarkBrush" Color="#1B5FD0"/>
  <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#3B8BFF" Offset="0"/>
    <GradientStop Color="#1B5FD0" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>

  <!-- 窗口 / 层次 -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F4F8"/>
  <SolidColorBrush x:Key="ContentBackgroundBrush" Color="Transparent"/>
  <SolidColorBrush x:Key="RegionBrush" Color="#E8FFFFFF"/>
  <SolidColorBrush x:Key="SecondaryRegionBrush" Color="#10000000"/>
  <SolidColorBrush x:Key="CardBorderBrush" Color="#1A000000"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#1A000000"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#14000000"/>
  <SolidColorBrush x:Key="NavBackgroundBrush" Color="#CCF7F8FB"/>
  <SolidColorBrush x:Key="TitleBarBrush" Color="Transparent"/>
  <SolidColorBrush x:Key="ToastBackgroundBrush" Color="#F7FFFFFF"/>
  <SolidColorBrush x:Key="ToastBorderBrush" Color="#22000000"/>
  <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#F7FFFFFF"/>
  <SolidColorBrush x:Key="MenuHoverBrush" Color="#14000000"/>

  <!-- 文本 -->
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1B1F24"/>
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5A6169"/>
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A9099"/>
  <SolidColorBrush x:Key="TextDisabledBrush" Color="#A9AEB6"/>

  <!-- 语义色 -->
  <SolidColorBrush x:Key="OkBrush" Color="#22A06B"/>
  <SolidColorBrush x:Key="OkLightBrush" Color="#E3F6EC"/>
  <SolidColorBrush x:Key="WarnBrush" Color="#D98200"/>
  <SolidColorBrush x:Key="WarnLightBrush" Color="#FCF1DD"/>
  <SolidColorBrush x:Key="ErrBrush" Color="#E5484D"/>
  <SolidColorBrush x:Key="ErrLightBrush" Color="#FDE8E8"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#E5484D"/>
  <SolidColorBrush x:Key="InfoBrush" Color="#2D7CF6"/>
  <SolidColorBrush x:Key="InfoLightBrush" Color="#E4EFFE"/>

  <!-- 交互控件 -->
  <SolidColorBrush x:Key="ControlBrush" Color="#0F000000"/>
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#19000000"/>
  <SolidColorBrush x:Key="ControlPressedBrush" Color="#24000000"/>
  <SolidColorBrush x:Key="ControlBorderBrush" Color="#26000000"/>
  <SolidColorBrush x:Key="InputBackgroundBrush" Color="#CCFFFFFF"/>
  <SolidColorBrush x:Key="TrackBrush" Color="#24000000"/>
  <SolidColorBrush x:Key="SelectionBrush" Color="#242D7CF6"/>
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#40000000"/>
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#66000000"/>
  <SolidColorBrush x:Key="RowHoverBrush" Color="#0D000000"/>
  <SolidColorBrush x:Key="NavItemHoverBrush" Color="#0F000000"/>
  <SolidColorBrush x:Key="NavItemActiveBrush" Color="#1F2D7CF6"/>
  <SolidColorBrush x:Key="NavItemActiveTextBrush" Color="#1B5FD0"/>
  <SolidColorBrush x:Key="FocusBrush" Color="#2D7CF6"/>
  <SolidColorBrush x:Key="LogBackgroundBrush" Color="#0A000000"/>
  <SolidColorBrush x:Key="BadgeBrush" Color="#14000000"/>
  <SolidColorBrush x:Key="ShadowBrush" Color="#22000000"/>
</ResourceDictionary>