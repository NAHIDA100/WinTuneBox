<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:WinTune.Wpf">

  <!-- ══════════ 导航 ══════════ -->
  <DataTemplate DataType="{x:Type vm:NavItem}">
    <RadioButton Style="{StaticResource NavItem}" GroupName="MainNav"
                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                 ToolTip="{Binding Title}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                   Width="21" VerticalAlignment="Center" TextAlignment="Center"/>
        <TextBlock Text="{Binding Title}" Margin="2,0,0,0" VerticalAlignment="Center"
                   Visibility="{Binding TextVisibility}"/>
      </StackPanel>
    </RadioButton>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:NavGroup}">
    <StackPanel>
      <TextBlock Text="{Binding Title}" Margin="18,12,0,4" FontSize="11" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextTertiaryBrush}" Visibility="{Binding HeaderVisibility}"/>
      <ItemsControl ItemsSource="{Binding Items}"/>
    </StackPanel>
  </DataTemplate>

  <!-- ══════════ 一键优化项 ══════════ -->
  <DataTemplate DataType="{x:Type vm:TweakItemVM}">
    <Border CornerRadius="6" Padding="10,7" Margin="0,1" Background="Transparent">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"/>

        <StackPanel Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                    Background="{DynamicResource WarnLightBrush}" Visibility="{Binding AdminVisibility}"
                    ToolTip="需要管理员权限">
              <TextBlock Text="管理员" FontSize="10.5" Foreground="{DynamicResource WarnBrush}"/>
            </Border>
            <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                    Background="{DynamicResource ErrLightBrush}" Visibility="{Binding RiskVisibility}"
                    ToolTip="风险项，默认不勾选">
              <TextBlock Text="谨慎" FontSize="10.5" Foreground="{DynamicResource ErrBrush}"/>
            </Border>
            <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                    Background="{DynamicResource BadgeBrush}" Visibility="{Binding TagVisibility}"
                    ToolTip="{Binding Tag}">
              <TextBlock Text="{Binding Tag}" FontSize="10.5"
                         Foreground="{DynamicResource SecondaryTextBrush}" MaxWidth="260"
                         TextTrimming="CharacterEllipsis"/>
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding Desc}" FontSize="11.6" Margin="0,3,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>

        <Border x:Name="Badge" Grid.Column="2" CornerRadius="4" Padding="8,3" VerticalAlignment="Center"
                Background="{DynamicResource BadgeBrush}">
          <TextBlock x:Name="BadgeText" Text="{Binding StatusText}" FontSize="11"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
        </Border>
      </Grid>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding StatusKind}" Value="ok">
        <Setter TargetName="Badge" Property="Background" Value="{DynamicResource OkLightBrush}"/>
        <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource OkBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusKind}" Value="warn">
        <Setter TargetName="Badge" Property="Background" Value="{DynamicResource WarnLightBrush}"/>
        <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource WarnBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusKind}" Value="na">
        <Setter TargetName="Badge" Property="Background" Value="{DynamicResource BadgeBrush}"/>
        <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsChecked}" Value="True">
        <Setter TargetName="Badge" Property="Opacity" Value="1"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- ══════════ 清理项 ══════════ -->
  <DataTemplate DataType="{x:Type vm:CleanItemVM}">
    <Border CornerRadius="6" Padding="10,8" Margin="0,1" Background="Transparent">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                    Background="{DynamicResource WarnLightBrush}" Visibility="{Binding AdminVisibility}">
              <TextBlock Text="管理员" FontSize="10.5" Foreground="{DynamicResource WarnBrush}"/>
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding Note}" FontSize="11.6" Margin="0,3,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
          <TextBlock Text="{Binding SizeText}" FontSize="13.5" FontWeight="SemiBold"
                     HorizontalAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/>
          <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Right"
                     Foreground="{DynamicResource TextTertiaryBrush}"/>
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>

  <!-- ══════════ 启动项 ══════════ -->
  <DataTemplate DataType="{x:Type vm:StartupItemVM}">
    <Border CornerRadius="6" Padding="10,8" Margin="0,1" Background="Transparent">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <ToggleButton Grid.Column="0" Style="{StaticResource Switch}" VerticalAlignment="Center"
                      IsChecked="{Binding Enabled, Mode=TwoWay}" ToolTip="启用 / 禁用该启动项"/>

        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                     Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Command}" FontSize="11.3" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>

        <Border Grid.Column="2" CornerRadius="4" Padding="7,2" VerticalAlignment="Center"
                Background="{DynamicResource BadgeBrush}">
          <TextBlock Text="{Binding SourceText}" FontSize="11"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
        </Border>

        <Button Grid.Column="3" Tag="delete" Style="{StaticResource BtnGhost}" Content="删除"
                Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="{Binding Loc}"/>
      </Grid>
    </Border>
  </DataTemplate>

  <!-- ══════════ 服务建议 ══════════ -->
  <DataTemplate DataType="{x:Type vm:ServiceItemVM}">
    <Border CornerRadius="6" Padding="10,8" Margin="0,1" Background="Transparent">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Display}" FontWeight="SemiBold" FontSize="13"
                     Foreground="{DynamicResource PrimaryTextBrush}"/>
          <TextBlock Text="{Binding Why}" FontSize="11.4" Margin="0,3,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
          <TextBlock FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}">
            <Run Text="当前 "/><Run Text="{Binding CurStart, Mode=OneWay}"/>
          </TextBlock>
          <TextBlock FontSize="11.5" Margin="0,2,0,0" Foreground="{DynamicResource OkBrush}">
            <Run Text="建议 "/><Run Text="{Binding RecStart, Mode=OneWay}"/>
          </TextBlock>
        </StackPanel>
        <Button Grid.Column="2" Tag="apply" Style="{StaticResource BtnDefault}" Content="按建议调整"
                VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </DataTemplate>

  <!-- ══════════ 软件 ══════════ -->
  <DataTemplate DataType="{x:Type vm:SoftwareItemVM}">
    <Border CornerRadius="6" Padding="10,8" Margin="0,1" Background="Transparent">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource PrimaryTextBrush}"/>
          <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
            <TextBlock Text="{Binding Version}" FontSize="11.4" Foreground="{DynamicResource SecondaryTextBrush}"/>
            <TextBlock Text=" · " FontSize="11.4" Foreground="{DynamicResource TextTertiaryBrush}"/>
            <TextBlock Text="{Binding Publisher}" FontSize="11.4" TextTrimming="CharacterEllipsis" MaxWidth="320"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
          </StackPanel>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12" Margin="12,0,12,0"
                   VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Tag="folder" Style="{StaticResource BtnGhost}" Content="目录" ToolTip="打开安装目录"/>
          <Button Tag="uninstall" Style="{StaticResource BtnDefault}" Content="卸载" Margin="8,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>

  <!-- ══════════ 快照 ══════════ -->
  <DataTemplate DataType="{x:Type vm:SnapshotItemVM}">
    <Border CornerRadius="6" Padding="10,8" Margin="0,1" Background="Transparent">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Display}" FontWeight="SemiBold" FontSize="13"
                     Foreground="{DynamicResource PrimaryTextBrush}"/>
          <TextBlock Text="{Binding Detail}" FontSize="11.4" Margin="0,3,0,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Tag="restore" Style="{StaticResource BtnPrimary}" Content="还原"/>
          <Button Tag="delete" Style="{StaticResource BtnGhost}" Content="删除" Margin="8,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>
  <!-- 分组头（优化项按分组显示） -->
  <GroupStyle x:Key="RowGroupStyle">
    <GroupStyle.HeaderTemplate>
      <DataTemplate>
        <TextBlock Text="{Binding Name}" Margin="2,14,0,4" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrandBrush}"/>
      </DataTemplate>
    </GroupStyle.HeaderTemplate>
    <GroupStyle.Panel>
      <ItemsPanelTemplate>
        <VirtualizingStackPanel/>
      </ItemsPanelTemplate>
    </GroupStyle.Panel>
  </GroupStyle>

</ResourceDictionary>