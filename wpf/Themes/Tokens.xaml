<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- ══ 字体：中文优先微软雅黑，图标用 Fluent Icons（Win10 回退 MDL2） ══ -->
  <FontFamily x:Key="AppFont">Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

  <!-- ══ 尺寸 token ══ -->
  <CornerRadius x:Key="CardRadius">8</CornerRadius>
  <CornerRadius x:Key="BtnRadius">6</CornerRadius>
  <CornerRadius x:Key="InputRadius">5</CornerRadius>
  <sys:Double x:Key="NavWidth">236</sys:Double>
  <sys:Double x:Key="NavCompactWidth">52</sys:Double>
  <sys:Double x:Key="TitleFontSize">22</sys:Double>
  <sys:Double x:Key="CardTitleFontSize">14.5</sys:Double>
  <sys:Double x:Key="BodyFontSize">12.8</sys:Double>
  <sys:Double x:Key="CaptionFontSize">11.5</sys:Double>
  <sys:Double x:Key="CaptionAreaHeight">44</sys:Double>

  <!-- ══ 全局默认文本 ══ -->
  <Style TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
    <Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  </Style>

  <Style TargetType="{x:Type TextBox}" x:Key="MonoTextBox">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
  </Style>
</ResourceDictionary>