<UserControl x:Class="WinTune.Wpf.Views.SnapshotPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
    <StackPanel Margin="30,26,30,26">

      <TextBlock Text="备份还原中心" FontSize="24" FontWeight="Bold"/>
      <TextBlock Text="优化前一键备份注册表关键分支与服务配置，出问题可整体恢复"
                 Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="1,4,0,14" TextWrapping="Wrap"/>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="创建快照" Style="{StaticResource CardTitle}"/>
          <TextBlock Style="{StaticResource CardSub}" Text="快照保存注册表关键分支（资源管理器、隐私、遥测、右键菜单等）与全部服务启动类型；恢复需要管理员权限"/>
          <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="WithRestorePoint" Content="同时创建 Windows 系统还原点（更彻底，需管理员并开启系统保护）" VerticalAlignment="Center" Margin="0,0,16,8" IsChecked="True"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="CreateBtn" Content="立即创建快照" Style="{StaticResource BtnPrimary}" Click="Create_Click"/>
            <Button Content="打开快照目录" Style="{StaticResource BtnDefault}" Click="OpenSnapshotDir_Click"/>
            <Button Content="打开注册表/文件备份目录" Style="{StaticResource BtnDefault}" Click="OpenBackupDir_Click"/>
          </StackPanel>
          <TextBox x:Name="Log" Style="{StaticResource LogBox}" Height="120" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="历史快照" Style="{StaticResource CardTitle}"/>
            <Button Grid.Column="1" Content="刷新" Style="{StaticResource BtnGhost}" Click="Refresh_Click"/>
          </Grid>
          <ListBox x:Name="List" Background="Transparent" BorderThickness="0">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Display}" FontWeight="SemiBold" FontSize="13.5"/>
                      <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Border CornerRadius="4" Padding="7,2" Background="{DynamicResource SecondaryRegionBrush}" Margin="0,0,6,0">
                          <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}">
                            <Run Text="注册表 "/><Run Text="{Binding RegFiles, Mode=OneWay}"/><Run Text=" 项"/>
                          </TextBlock>
                        </Border>
                        <Border CornerRadius="4" Padding="7,2" Background="{DynamicResource SecondaryRegionBrush}" Margin="0,0,6,0">
                          <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="服务配置"/>
                        </Border>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Width="64" Style="{StaticResource BtnPrimary}" Padding="8,5" Margin="0,0,6,0" Content="恢复" Click="Restore_Click"/>
                      <Button Width="64" Style="{StaticResource BtnDefault}" Padding="8,5" Margin="0,0,6,0" Content="打开" Click="Open_Click"/>
                      <Button Width="64" Style="{StaticResource BtnDanger}" Padding="8,5" Content="删除" Click="Delete_Click"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
