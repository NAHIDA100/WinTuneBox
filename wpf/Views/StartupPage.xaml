<UserControl x:Class="WinTune.Wpf.Views.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="30,26,30,26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="启动项管理" FontSize="24" FontWeight="Bold"/>
        <TextBlock Text="管理注册表、启动文件夹与计划任务中的开机自启程序（兼容 Win7~Win11）"
                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="1,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="OpenFolderBtn" Content="启动文件夹" Style="{StaticResource BtnDefault}" Click="OpenFolder_Click"/>
        <Button x:Name="AddBtn" Content="添加启动项" Style="{StaticResource BtnDefault}" Click="Add_Click"/>
        <Button x:Name="RefreshBtn" Content="刷新" Style="{StaticResource BtnPrimary}" Click="Refresh_Click"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="260"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="Summary" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="加载中…"/>
      <TextBox x:Name="Search" Grid.Column="1" TextChanged="Search_Changed" Tag="输入关键字过滤…"/>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
      <ListBox x:Name="List" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                    <Border x:Name="SrcTag" CornerRadius="4" Margin="8,0,0,0" Padding="7,2" VerticalAlignment="Center"
                            Background="{DynamicResource SecondaryRegionBrush}">
                      <TextBlock Text="{Binding Loc}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Command}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"
                             TextTrimming="CharacterEllipsis" MaxWidth="560" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border x:Name="StateTag" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="StateText" FontSize="11"/>
                  </Border>
                  <Button x:Name="ToggleBtn" Width="64" Style="{StaticResource BtnDefault}" Margin="0,0,6,0"
                          Padding="8,5" Click="Toggle_Click"/>
                  <Button Width="56" Style="{StaticResource BtnDanger}" Padding="8,5" Content="删除" Click="Delete_Click"/>
                </StackPanel>
              </Grid>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Enabled}" Value="True">
                <Setter TargetName="StateTag" Property="Background" Value="{StaticResource OkLightBrush}"/>
                <Setter TargetName="StateText" Property="Text" Value="已启用"/>
                <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource OkBrush}"/>
                <Setter TargetName="ToggleBtn" Property="Content" Value="禁用"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Enabled}" Value="False">
                <Setter TargetName="StateTag" Property="Background" Value="{StaticResource WarnLightBrush}"/>
                <Setter TargetName="StateText" Property="Text" Value="已禁用"/>
                <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                <Setter TargetName="ToggleBtn" Property="Content" Value="启用"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</UserControl>
